# Docker only listens on the VPS loopback interface by default.
DADKIT_BIND_ADDRESS=127.0.0.1
DADKIT_PORT=3333

# Set this to the public HTTPS origin served by your reverse proxy.
# Do not include a trailing slash.
DADKIT_PUBLIC_ORIGIN=https://dadkit.505f.com

# Optional exact HTTPS origins that serve the same DadKit instance, separated
# by commas. Do not use wildcards. Leave empty for a single-origin deployment.
DADKIT_TRUSTED_ORIGINS=

# Exact WebDAV hosts that the same-origin proxy may contact, comma-separated.
# Leave empty to disable the proxy. Wildcards are intentionally unsupported.
# Example: webdav.example.com,dav.example.com:8443
DADKIT_WEBDAV_PROXY_ALLOWED_HOSTS=

# Prebuilt image pulled by Docker Compose and the deployment scripts.
# The default is ghcr.io/yepixpert/dadkit:latest; override only for a mirror.
# DADKIT_IMAGE=ghcr.io/yepixpert/dadkit:latest

# Directory where family-sync data is stored inside the container.
# The default is backed by the dadkit-data named volume; change both together.
# DADKIT_DATA_DIR=/app/data

# Public family-sync service policy. Existing spaces keep working when
# registration is closed. Public deployments must terminate HTTPS.
DADKIT_SYNC_REGISTRATION_MODE=open
DADKIT_SYNC_MAX_SPACE_BYTES=25165824
DADKIT_SYNC_MAX_DEVICES=12
DADKIT_SYNC_MAX_ACTIVE_INVITES=5
DADKIT_SYNC_DEFAULT_INVITE_TTL_MINUTES=30
DADKIT_SYNC_MAX_INVITE_TTL_MINUTES=1440

# Set this to the exact number of trusted reverse-proxy hops. Code defaults to
# 0 (do not trust forwarding headers); one Nginx layer commonly uses 1.
DADKIT_TRUST_PROXY_HOPS=1
DADKIT_SYNC_REQUIRE_HTTPS=true
