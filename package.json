{
  "name": "dadkit",
  "version": "3.4.8",
  "private": true,
  "description": "A local-first maternity preparation app for web and Android.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit",
    "test:docker": "vitest run --config vitest.docker.config.ts tests/docker-integration.test.ts",
    "performance:check": "node scripts/check-performance-budgets.mjs",
    "android:bundle": "node scripts/build-android-web.mjs",
    "android:validate": "node scripts/validate-android-release.mjs",
    "webdav:verify": "node scripts/verify-webdav-acceptance.mjs",
    "webdav:verify:prompt": "powershell -ExecutionPolicy Bypass -File scripts/verify-webdav-acceptance.ps1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.62.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.5.21",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "$postcss"
  }
}
